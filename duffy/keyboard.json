{
    "keyboard_name": "Duffy",
    "manufacturer": "zankia",
    "maintainer": "zankia",
    "usb": {
        "vid": "0x027E",
        "pid": "0x0000",
        "device_version": "1.0.0"
    },
    "processor": "RP2040",
    "bootloader": "rp2040",
    "features": {
        "bootmagic": true,
        "encoder": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "pointing_device": true,
        "rgb_matrix": true
    },
    "diode_direction": "COL2ROW",
    "matrix_pins": {
        "cols": ["GP21", "GP23", "GP20"],
        "rows": ["GP7", "GP8", "GP9"]
    },
    "rgb_matrix": {
        "led_count": 6,
        "driver": "ws2812",
        "layout": [
           {"flags": 4, "matrix": [0, 0], "x": 0,   "y": 0},
           {"flags": 4, "matrix": [0, 1], "x": 112, "y": 0},
           {"flags": 4, "matrix": [0, 2], "x": 224, "y": 0},
           {"flags": 4, "matrix": [1, 2], "x": 0,   "y": 64},
           {"flags": 4, "matrix": [1, 1], "x": 112, "y": 64},
           {"flags": 4, "matrix": [1, 0], "x": 224, "y": 64}
        ],
        "default": {
            "hue": 180,
            "val": 127
        },
        "sleep": true,
        "timeout": 600000
    },
    "ws2812": {
        "driver": "vendor",
        "pin": "GP25"
    },
    "encoder": {
        "rotary": [
            { "pin_a": "GP27", "pin_b": "GP28" },
            { "pin_a": "GP27", "pin_b": "GP29" }
        ]
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},
                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1},
                {"matrix": [2, 0], "x": 0, "y": 1},
                {"matrix": [2, 1], "x": 1, "y": 1},
                {"matrix": [2, 2], "x": 2, "y": 1}
            ]
        }
    }
}
